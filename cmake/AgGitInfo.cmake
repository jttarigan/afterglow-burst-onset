# Script mode (cmake -P): writes GitInfo.h with the current commit and dirty flag, only when
# they change. Copied from NeonTide/cmake/NtGitInfo.cmake (commit 3dc7266), which adapted Lightbound/cmake/LbGitInfo.cmake.
#   -DSRC=<repo root> -DOUT=<header path>
# Untracked files count as dirty too: an unrecorded new source file can change the build.
execute_process(COMMAND git rev-parse HEAD
                WORKING_DIRECTORY "${SRC}" OUTPUT_VARIABLE commit RESULT_VARIABLE rc
                OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
if(NOT rc EQUAL 0 OR commit STREQUAL "")
  set(commit "nogit")
  set(dirty 1)
else()
  execute_process(COMMAND git status --porcelain
                  WORKING_DIRECTORY "${SRC}" OUTPUT_VARIABLE status ERROR_QUIET)
  if(status STREQUAL "")
    set(dirty 0)
  else()
    set(dirty 1)
  endif()
endif()
set(content "#pragma once\n// Generated by cmake/AgGitInfo.cmake at build time.\n#define AG_GIT_COMMIT \"${commit}\"\n#define AG_GIT_DIRTY ${dirty}\n")
set(old "")
if(EXISTS "${OUT}")
  file(READ "${OUT}" old)
endif()
if(NOT old STREQUAL content)
  file(WRITE "${OUT}" "${content}")
endif()
